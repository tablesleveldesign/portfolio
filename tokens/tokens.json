{
  "$description": "Single source for the portfolio design foundation. Primitives hold raw values; semantic tokens reference primitives per theme. Components only ever use semantic tokens.",
  "primitive": {
    "color": {
      "neutral": {
        "0": "#ffffff",
        "50": "#f7f6f3",
        "100": "#eeece6",
        "200": "#dedad1",
        "300": "#c4bfb3",
        "400": "#9f998b",
        "500": "#7b7567",
        "600": "#5e594d",
        "700": "#47433a",
        "800": "#2f2c26",
        "900": "#1e1c18",
        "950": "#13120f"
      },
      "teal": {
        "100": "#d7efe9",
        "300": "#7fcbb9",
        "400": "#4fb39d",
        "500": "#2a9580",
        "600": "#1f7766",
        "700": "#195e51",
        "800": "#144a40"
      }
    },
    "space": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "6": "1.5rem",
      "8": "2rem",
      "12": "3rem",
      "16": "4rem"
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px"
    },
    "font": {
      "family": {
        "sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      },
      "size": {
        "-1": "0.8rem",
        "0": "1rem",
        "1": "1.25rem",
        "2": "1.563rem",
        "3": "1.953rem",
        "4": "2.441rem"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "bold": "700"
      },
      "leading": {
        "tight": "1.2",
        "normal": "1.6"
      }
    }
  },
  "semantic": {
    "light": {
      "surface-base": "{color.neutral.50}",
      "surface-raised": "{color.neutral.0}",
      "surface-sunken": "{color.neutral.100}",
      "border-default": "{color.neutral.200}",
      "border-strong": "{color.neutral.300}",
      "text-primary": "{color.neutral.900}",
      "text-secondary": "{color.neutral.700}",
      "text-muted": "{color.neutral.600}",
      "accent-default": "{color.teal.700}",
      "accent-hover": "{color.teal.800}",
      "accent-text": "{color.teal.700}",
      "accent-contrast": "{color.neutral.0}",
      "accent-subtle": "{color.teal.100}",
      "focus-ring": "{color.teal.500}"
    },
    "dark": {
      "surface-base": "{color.neutral.950}",
      "surface-raised": "{color.neutral.900}",
      "surface-sunken": "{color.neutral.800}",
      "border-default": "{color.neutral.800}",
      "border-strong": "{color.neutral.700}",
      "text-primary": "{color.neutral.50}",
      "text-secondary": "{color.neutral.200}",
      "text-muted": "{color.neutral.400}",
      "accent-default": "{color.teal.400}",
      "accent-hover": "{color.teal.300}",
      "accent-text": "{color.teal.300}",
      "accent-contrast": "{color.neutral.950}",
      "accent-subtle": "{color.teal.800}",
      "focus-ring": "{color.teal.400}"
    }
  },
  "contrastPairs": [
    { "fg": "text-primary", "bg": "surface-base", "min": 4.5 },
    { "fg": "text-primary", "bg": "surface-raised", "min": 4.5 },
    { "fg": "text-secondary", "bg": "surface-base", "min": 4.5 },
    { "fg": "text-secondary", "bg": "surface-raised", "min": 4.5 },
    { "fg": "text-muted", "bg": "surface-base", "min": 4.5 },
    { "fg": "text-muted", "bg": "surface-raised", "min": 4.5 },
    { "fg": "accent-text", "bg": "surface-base", "min": 4.5 },
    { "fg": "accent-contrast", "bg": "accent-default", "min": 4.5 },
    { "fg": "accent-contrast", "bg": "accent-hover", "min": 4.5 },
    { "fg": "focus-ring", "bg": "surface-base", "min": 3 }
  ]
}
