{
  "$description": "Single source for the portfolio design foundation. Primitives hold raw values; semantic tokens reference primitives per theme. Components only ever use semantic tokens.",
  "primitive": {
    "color": {
      "neutral": {
        "0": "#ffffff",
        "50": "#f4f1ea",
        "100": "#eeebe4",
        "150": "#ebe6db",
        "200": "#cfc8bb",
        "400": "#a39d93",
        "600": "#6b665e",
        "700": "#3b3833",
        "800": "#211f24",
        "900": "#1b1b1f",
        "950": "#17161a"
      },
      "orange": {
        "100": "#f9dccf",
        "400": "#f48b63",
        "500": "#ef6a3d",
        "600": "#e2572b",
        "700": "#b2401a",
        "900": "#4a2315"
      }
    },
    "space": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "7": "1.75rem",
      "8": "2rem",
      "9": "2.25rem",
      "10": "2.5rem",
      "11": "2.75rem",
      "12": "3rem",
      "14": "3.5rem",
      "16": "4rem",
      "18": "4.5rem"
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "full": "999px"
    },
    "font": {
      "family": {
        "sans": "\"Bricolage Grotesque\", \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
      },
      "size": {
        "0": "1rem",
        "1": "1.125rem",
        "2": "1.3125rem",
        "3": "1.5rem",
        "4": "2.25rem",
        "5": "3.5rem",
        "-2": "0.75rem",
        "-1": "0.8125rem"
      },
      "body-small": "1.0625rem",
      "hero": {
        "name-min": "3rem",
        "name-max": "4.5rem",
        "headline-min": "1.375rem",
        "headline-max": "2.125rem",
        "step": "1.25rem",
        "step-small": "1.0625rem",
        "quote": "0.9375rem",
        "link": "0.875rem",
        "bar-small": "0.71875rem",
        "label-small": "0.6875rem",
        "detail-small": "0.6875rem"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "leading": {
        "display": "1.05",
        "tight": "1.2",
        "normal": "1.55"
      }
    }
  },
  "semantic": {
    "light": {
      "surface-base": "{color.neutral.50}",
      "surface-raised": "{color.neutral.0}",
      "surface-sunken": "{color.neutral.150}",
      "surface-inverse": "{color.neutral.900}",
      "border-default": "{color.neutral.200}",
      "border-strong": "{color.neutral.400}",
      "text-primary": "{color.neutral.900}",
      "text-secondary": "{color.neutral.700}",
      "text-muted": "{color.neutral.600}",
      "text-inverse": "{color.neutral.50}",
      "accent-default": "{color.orange.600}",
      "accent-hover": "{color.orange.500}",
      "accent-text": "{color.orange.700}",
      "accent-contrast": "{color.neutral.900}",
      "accent-subtle": "{color.orange.100}",
      "focus-ring": "{color.orange.600}"
    },
    "dark": {
      "surface-base": "{color.neutral.950}",
      "surface-raised": "{color.neutral.800}",
      "surface-sunken": "{color.neutral.800}",
      "surface-inverse": "{color.neutral.100}",
      "border-default": "{color.neutral.700}",
      "border-strong": "{color.neutral.600}",
      "text-primary": "{color.neutral.100}",
      "text-secondary": "{color.neutral.200}",
      "text-muted": "{color.neutral.400}",
      "text-inverse": "{color.neutral.950}",
      "accent-default": "{color.orange.500}",
      "accent-hover": "{color.orange.400}",
      "accent-text": "{color.orange.400}",
      "accent-contrast": "{color.neutral.950}",
      "accent-subtle": "{color.orange.900}",
      "focus-ring": "{color.orange.500}"
    }
  },
  "contrastPairs": [
    { "fg": "text-primary", "bg": "surface-base", "min": 4.5 },
    { "fg": "text-primary", "bg": "surface-raised", "min": 4.5 },
    { "fg": "text-secondary", "bg": "surface-base", "min": 4.5 },
    { "fg": "text-secondary", "bg": "surface-raised", "min": 4.5 },
    { "fg": "text-muted", "bg": "surface-base", "min": 4.5 },
    { "fg": "text-muted", "bg": "surface-raised", "min": 4.5 },
    { "fg": "text-primary", "bg": "surface-sunken", "min": 4.5 },
    { "fg": "text-muted", "bg": "surface-sunken", "min": 4.5 },
    { "fg": "text-inverse", "bg": "surface-inverse", "min": 4.5 },
    { "fg": "accent-text", "bg": "surface-base", "min": 4.5 },
    { "fg": "accent-text", "bg": "surface-sunken", "min": 4.5 },
    { "fg": "accent-contrast", "bg": "accent-default", "min": 4.5 },
    { "fg": "accent-contrast", "bg": "accent-hover", "min": 4.5 },
    { "fg": "focus-ring", "bg": "surface-base", "min": 3 }
  ]
}
